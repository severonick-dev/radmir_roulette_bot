# Telegram
BOT_TOKEN=put-your-bot-token-here
# Telegram ID админов через запятую (всегда есть доступ), напр. 123456789,987654321
ADMIN_IDS=

# Хранилище
# Dev (SQLite, ноль настройки):
DATABASE_URL=sqlite+aiosqlite:///./radmir.db
# Прод (Postgres) — пример:
# DATABASE_URL=postgresql+asyncpg://radmir:password@localhost:5432/radmir
# окно анализа на 1 стол (сервер+казино+стол): храним всё, анализируем последние N (250–350)
ANALYSIS_WINDOW=300

# ИИ — RouterAI (OpenAI-совместимый), модель DeepSeek
AI_API_KEY=put-your-routerai-key-here
AI_BASE_URL=https://routerai.ru/api/v1
AI_MODEL=deepseek/deepseek-v4-flash
# v4-flash — reasoning-модель, часть токенов уходит в рассуждение → лимит с запасом
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# Прод: домен для webhook
PUBLIC_URL=https://proxels-web.ru

LOG_LEVEL=INFO
